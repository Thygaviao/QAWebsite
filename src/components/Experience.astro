---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="experience"
  class="py-14 md:py-20 border-b border-slate-200/80 dark:border-slate-800/80"
  aria-labelledby="experience-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl mb-10">
      <h2
        id="experience-title"
        class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.experience.sectionTitle}
      </h2>
      <div class="mt-2 h-1 w-12 bg-brand-500 rounded-full"></div>
    </div>

    <!-- Experience Cards -->
    <div class="space-y-10">
      {
        t.experience.items.map((exp, index) => (
          <article
            class="relative rounded-xl border border-slate-200/80 bg-white p-6 sm:p-7 shadow-xs transition-colors dark:border-slate-800 dark:bg-slate-900/60"
            aria-labelledby={`exp-heading-${index}`}
          >
            <!-- Card Header -->
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between border-b border-slate-100 pb-4 dark:border-slate-800/80 gap-2">
              <div>
                <div class="flex items-center gap-3 flex-wrap">
                  <h3
                    id={`exp-heading-${index}`}
                    class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white"
                  >
                    {exp.company}
                  </h3>
                  <span class="rounded bg-brand-50 px-2.5 py-0.5 font-mono text-xs font-semibold text-brand-700 dark:bg-brand-950/60 dark:text-brand-300 border border-brand-200/60 dark:border-brand-800/60">
                    {exp.role}
                  </span>
                </div>
                <div class="mt-1 text-sm font-mono text-slate-500 dark:text-slate-400">
                  {exp.focus}
                </div>
              </div>
              <div class="font-mono text-xs sm:text-sm font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap">
                {exp.period}
              </div>
            </div>

            <!-- Context Description -->
            <p class="mt-4 text-sm sm:text-base font-medium text-slate-700 dark:text-slate-300">
              {exp.description}
            </p>

            <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-7 items-start">
              <!-- Key Achievements (Primary Focus - Visually Prominent) -->
              <div class="lg:col-span-7 rounded-lg bg-slate-50/70 p-4 sm:p-5 border border-slate-200/70 dark:bg-slate-800/30 dark:border-slate-800/70">
                <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300 mb-3.5 flex items-center gap-2">
                  <svg class="h-4 w-4 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{t.experience.achievementsLabel}</span>
                </h4>
                <ul class="space-y-3 text-sm text-slate-800 dark:text-slate-200 list-none p-0 m-0">
                  {
                    exp.achievements.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 dark:bg-brand-400" aria-hidden="true"></span>
                        <span class="leading-relaxed" set:html={item.replace(/^[•\-\*]\s*/, '')} />
                      </li>
                    ))
                  }
                </ul>
              </div>

              <!-- Responsibilities & Stack (Secondary - Compact) -->
              <div class="lg:col-span-5 flex flex-col justify-between space-y-5">
                <div>
                  <h4 class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2.5">
                    {t.experience.responsibilitiesLabel}
                  </h4>
                  <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400 list-none p-0 m-0">
                    {
                      exp.responsibilities.map((task) => (
                        <li class="flex items-start gap-2">
                          <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-slate-400 dark:bg-slate-600" aria-hidden="true"></span>
                          <span class="leading-normal">{task.replace(/^[•\-\*]\s*/, '')}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>

                <!-- Tech Stack Tags -->
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                  <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">
                    {t.experience.techStackLabel}
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {
                      exp.tech.map((tech) => (
                        <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-mono text-slate-700 transition-colors hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                          {tech}
                        </span>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
