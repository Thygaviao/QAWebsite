---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="languages"
  class="py-8 sm:py-10 border-b border-slate-200/70 bg-slate-50/20 dark:border-slate-800/70 dark:bg-slate-900/10"
  aria-labelledby="languages-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-6">
      <h2
        id="languages-title"
        class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.languages.sectionTitle}
      </h2>
      <div class="mt-1 h-0.5 w-8 bg-brand-500 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 max-w-lg">
      {
        t.languages.items.map((item) => (
          <div class="flex items-center justify-between rounded-lg border border-slate-200/80 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 shadow-2xs">
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">
              {item.language}
            </span>
            <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
              {item.level}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
