---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="cases"
  class="py-16 md:py-20 border-b border-slate-200/80 bg-slate-50/40 dark:border-slate-800/80 dark:bg-slate-900/20"
  aria-labelledby="cases-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <h2
        id="cases-title"
        class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.cases.sectionTitle}
      </h2>
      <div class="mt-2 h-1 w-12 bg-brand-500 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        t.cases.items.map((item, index) => (
          <div
            class="flex flex-col justify-between rounded-xl border border-slate-200/80 bg-white p-6 shadow-xs transition-all dark:border-slate-800 dark:bg-slate-900"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                <span class="font-bold text-brand-600 dark:text-brand-400">CASE 0{index + 1}</span>
                <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-600 dark:text-slate-400">
                  Engineering
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-snug">
                {item.title}
              </h3>

              <!-- Problem -->
              <div class="mt-5 space-y-1">
                <div class="text-[11px] font-mono font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-400">
                  {t.cases.problemLabel}
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  {item.problem}
                </p>
              </div>

              <!-- Work Done -->
              <div class="mt-4 space-y-1">
                <div class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  {t.cases.solutionLabel}
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  {item.work}
                </p>
              </div>
            </div>

            <!-- Result -->
            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80">
              <div class="text-[11px] font-mono font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                {t.cases.resultLabel}
              </div>
              <p class="mt-1 text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug">
                {item.result}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
