---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="cases"
  class="py-8 sm:py-10 border-b border-slate-200/70 bg-slate-50/30 dark:border-slate-800/70 dark:bg-slate-900/10"
  aria-labelledby="cases-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-6 sm:mb-8">
      <h2
        id="cases-title"
        class="text-2xl sm:text-[26px] font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.cases.sectionTitle}
      </h2>
      <div class="mt-1.5 h-0.5 w-10 bg-brand-500 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
      {
        t.cases.items.map((item, index) => (
          <div
            class="flex flex-col justify-between h-full rounded-xl border border-slate-200/80 bg-white p-4 sm:p-5 shadow-2xs transition-all dark:border-slate-800 dark:bg-slate-900"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
                <span class="font-bold text-brand-600 dark:text-brand-400">CASE 0{index + 1}</span>
                <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Engineering
                </span>
              </div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
                {item.title}
              </h3>

              <!-- 1. Problem (Quiet) -->
              <div class="mt-3.5 space-y-0.5">
                <div class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  {t.cases.problemLabel}
                </div>
                <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed">
                  {item.problem}
                </p>
              </div>

              <!-- 2. What was done (Context) -->
              <div class="mt-3 space-y-0.5">
                <div class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  {t.cases.solutionLabel}
                </div>
                <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-300 leading-relaxed">
                  {item.work}
                </p>
              </div>
            </div>

            <!-- 3. Result (Visually strongest subsection) -->
            <div class="mt-4 rounded-lg border-l-4 border-brand-600 bg-brand-50/70 p-3 dark:border-brand-400 dark:bg-brand-950/30">
              <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300">
                {t.cases.resultLabel}
              </div>
              <p class="mt-0.5 text-xs sm:text-[13px] font-bold text-slate-900 dark:text-white leading-snug">
                {item.result}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
