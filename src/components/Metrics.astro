---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="metrics"
  class="py-8 sm:py-10 border-b border-slate-200/70 bg-slate-50/40 dark:border-slate-800/70 dark:bg-slate-900/20"
  aria-label={t.metrics.sectionTitle}
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 min-[420px]:grid-cols-2 md:grid-cols-5 gap-3 sm:gap-4">
      {
        t.metrics.items.map((item, index) => (
          <div
            class={`flex flex-col justify-between h-full rounded-lg border border-slate-200/80 bg-white p-3.5 sm:p-4 shadow-2xs transition-colors dark:border-slate-800 dark:bg-slate-900 ${
              index === 4 ? 'min-[420px]:col-span-2 md:col-span-1' : ''
            }`}
          >
            <div>
              <!-- Strongest element: Metric Number -->
              <div class="font-mono text-2xl sm:text-[28px] font-extrabold tracking-tight text-slate-900 dark:text-white break-words">
                {item.value}
              </div>
              <!-- Quieter element: Description -->
              <div class="mt-1.5 text-xs sm:text-[13px] font-medium leading-snug text-slate-600 dark:text-slate-300">
                {item.label}
              </div>
            </div>
            <!-- Supporting text: Smaller & Lower Contrast -->
            {item.subtext && (
              <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/70 text-[11px] font-mono text-slate-400 dark:text-slate-500 leading-tight">
                {item.subtext}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
