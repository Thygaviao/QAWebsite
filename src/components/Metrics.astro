---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="metrics"
  class="py-10 sm:py-12 border-b border-slate-200/80 bg-slate-50/60 dark:border-slate-800/80 dark:bg-slate-900/30"
  aria-label={t.metrics.sectionTitle}
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3.5 sm:gap-5">
      {
        t.metrics.items.map((item, index) => (
          <div
            class={`flex flex-col justify-between rounded-lg border border-slate-200/80 bg-white p-4 sm:p-5 shadow-xs transition-colors dark:border-slate-800 dark:bg-slate-900 ${
              index === 4 ? 'col-span-2 md:col-span-1' : ''
            }`}
          >
            <div>
              <div class="font-mono text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white break-words">
                {item.value}
              </div>
              <div class="mt-2 text-xs sm:text-sm font-semibold leading-snug text-slate-700 dark:text-slate-300">
                {item.label}
              </div>
            </div>
            {item.subtext && (
              <div class="mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800/70 text-[11px] font-mono text-slate-500 dark:text-slate-400 leading-tight">
                {item.subtext}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
