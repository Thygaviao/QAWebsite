---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="skills"
  class="py-16 md:py-20 border-b border-slate-200/80 dark:border-slate-800/80"
  aria-labelledby="skills-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10">
      <h2
        id="skills-title"
        class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.skills.sectionTitle}
      </h2>
      <div class="mt-2 h-1 w-12 bg-brand-500 rounded-full"></div>
    </div>

    <!-- Highlighted Primary Skills (Top 5) -->
    <div class="mb-10 rounded-xl border border-brand-200/70 bg-brand-50/40 p-6 dark:border-brand-900/60 dark:bg-brand-950/20">
      <div class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-300 mb-3 flex items-center gap-2">
        <svg class="h-4 w-4 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{t.skills.primaryTitle}</span>
      </div>
      <div class="flex flex-wrap gap-2.5">
        {
          t.skills.primarySkills.map((skill) => (
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-brand-300 bg-white px-3.5 py-1.5 text-sm font-semibold text-brand-900 shadow-xs dark:border-brand-800 dark:bg-slate-900 dark:text-brand-200">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
              {skill}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Categorized Skill Groups Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        t.skills.groups.map((group) => (
          <div class="rounded-lg border border-slate-200/80 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/60 shadow-xs">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3.5">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                group.skills.map((skill) => (
                  <span class="rounded bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
