---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="skills"
  class="py-8 sm:py-10 md:py-12 border-b border-slate-200/70 dark:border-slate-800/70"
  aria-labelledby="skills-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-6 sm:mb-8">
      <h2
        id="skills-title"
        class="text-2xl sm:text-[26px] font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.skills.sectionTitle}
      </h2>
      <div class="mt-1.5 h-0.5 w-10 bg-brand-500 rounded-full"></div>
    </div>

    <!-- Highlighted Primary Skills (Top 5 Core Competencies) -->
    <div class="mb-6 rounded-lg border border-slate-200/90 bg-slate-50/70 p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900/50">
      <div class="text-[11px] font-mono font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-300 mb-2.5 flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{t.skills.primaryTitle}</span>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          t.skills.primarySkills.map((skill) => (
            <span class="inline-flex items-center gap-1.5 rounded-md border border-slate-300/80 bg-white px-3 py-1 text-xs font-semibold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
              {skill}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Categorized Skill Groups Grid (Calm, scannable inline list — avoids a wall of pills) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
      {
        t.skills.groups.map((group) => (
          <div class="rounded-lg border border-slate-200/70 bg-white p-3.5 dark:border-slate-800/70 dark:bg-slate-900/40">
            <h3 class="text-[11px] font-mono font-medium uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1.5">
              {group.category}
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-400 leading-relaxed">
              {group.skills.join(' · ')}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
