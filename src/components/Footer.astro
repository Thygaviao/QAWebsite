---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="py-8 border-t border-slate-200/70 bg-white dark:border-slate-800/70 dark:bg-slate-950 transition-colors" role="contentinfo">
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="font-bold text-slate-900 dark:text-white">
          {t.footer.name}
        </div>
        <div class="text-xs font-mono text-slate-500 dark:text-slate-400">
          {t.footer.role}
        </div>
      </div>

      <div class="flex items-center gap-6 text-xs text-slate-500 dark:text-slate-400">
        <span>© {currentYear} {t.footer.name}.</span>
        <a
          href="#top"
          id="back-to-top"
          class="font-medium hover:text-brand-600 dark:hover:text-brand-400 transition-colors flex items-center gap-1 cursor-pointer"
        >
          <span>{t.footer.backToTop}</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    const backToTopBtn = document.getElementById('back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        if (window.location.hash) {
          history.pushState(null, '', window.location.pathname);
        }
      });
    }
  </script>
</footer>
