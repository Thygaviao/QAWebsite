---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="about"
  class="py-16 md:py-20 border-b border-slate-200/80 dark:border-slate-800/80"
  aria-labelledby="about-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- Left column: Section Title & Focus Summary -->
      <div class="lg:col-span-4">
        <h2
          id="about-title"
          class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
        >
          {t.about.sectionTitle}
        </h2>
        <div class="mt-2 h-1 w-12 bg-brand-500 rounded-full"></div>

        <!-- Key Highlights Card -->
        <div class="mt-8 rounded-lg border border-slate-200/80 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
          <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            {t.about.keyHighlightsTitle}
          </h3>
          <ul class="mt-3.5 space-y-2.5 text-sm text-slate-700 dark:text-slate-300">
            {
              t.about.keyHighlights.map((highlight) => (
                <li class="flex items-start gap-2.5">
                  <svg
                    class="h-4 w-4 shrink-0 text-brand-600 dark:text-brand-400 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right column: Narrative text -->
      <div class="lg:col-span-8 space-y-4 text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {
          t.about.paragraphs.map((p) => (
            <p>{p}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
