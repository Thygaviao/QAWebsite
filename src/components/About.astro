---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="about"
  class="py-10 sm:py-12 md:py-14 border-b border-slate-200/70 dark:border-slate-800/70"
  aria-labelledby="about-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Left column: Section Title & Compact Focus Box -->
      <div class="lg:col-span-4">
        <h2
          id="about-title"
          class="text-2xl sm:text-[26px] font-bold tracking-tight text-slate-900 dark:text-white"
        >
          {t.about.sectionTitle}
        </h2>
        <div class="mt-1.5 h-0.5 w-10 bg-brand-500 rounded-full"></div>

        <!-- Compact Key Highlights Card -->
        <div class="mt-6 rounded-lg border border-slate-200/80 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/50">
          <h3 class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5">
            {t.about.keyHighlightsTitle}
          </h3>
          <ul class="space-y-2 text-xs text-slate-700 dark:text-slate-300 list-none p-0 m-0">
            {
              t.about.keyHighlights.map((highlight) => (
                <li class="flex items-start gap-2">
                  <svg
                    class="h-3.5 w-3.5 shrink-0 text-brand-600 dark:text-brand-400 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right column: Narrative text (Compact & Fast to scan) -->
      <div class="lg:col-span-8 space-y-3 text-[15px] sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {
          t.about.paragraphs.map((p) => (
            <p>{p}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
