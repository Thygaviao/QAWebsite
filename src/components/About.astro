---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="about"
  class="py-6 sm:py-8 border-b border-slate-200/70 dark:border-slate-800/70"
  aria-labelledby="about-title"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2
        id="about-title"
        class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {t.about.sectionTitle}
      </h2>
      <div class="mt-1.5 h-0.5 w-8 bg-brand-500 rounded-full"></div>

      <div class="mt-3.5 space-y-2.5 text-[15px] sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 font-normal">
        {
          t.about.paragraphs.map((p) => (
            <p>{p}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
