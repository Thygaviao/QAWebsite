---
import type { Locale, Translations } from '../i18n/types';
import { siteConfig } from '../data/config';

interface Props {
  t: Translations;
  locale: Locale;
}

const { t, locale } = Astro.props;
const currentCv = siteConfig.cv[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header
  class="sticky top-0 z-50 w-full border-b border-slate-200/70 bg-white/90 backdrop-blur-md transition-colors duration-200 dark:border-slate-800/70 dark:bg-slate-950/90"
  role="banner"
>
  <div class="mx-auto flex h-14 max-w-content items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Name -->
    <a
      href={`${base}/${locale}`}
      class="group flex items-center gap-2.5 text-slate-900 transition-colors dark:text-slate-100"
      aria-label={`${t.header.name} — ${t.header.role}`}
    >
      <span class="flex h-7 w-7 items-center justify-center rounded bg-slate-900 font-mono text-xs font-bold text-white transition-transform group-hover:scale-105 dark:bg-brand-500 dark:text-slate-950">
        QA
      </span>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100">
          {t.header.name}
        </span>
        <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">
          {t.header.role}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
      <ul class="flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
        {
          t.header.nav.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="transition-colors hover:text-brand-600 dark:hover:text-brand-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded px-1.5 py-1"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Controls: Language Switcher + Theme Toggle + Mobile Menu Button -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Language Switcher -->
      <div
        class="flex items-center rounded-md border border-slate-200 bg-slate-100/80 p-0.5 text-xs font-mono font-medium dark:border-slate-800 dark:bg-slate-900"
        role="group"
        aria-label="Language selection"
      >
        <a
          href={`${base}/ru`}
          data-lang="ru"
          class={`lang-link px-2.5 py-1 rounded transition-colors ${
            locale === 'ru'
              ? 'bg-white font-bold text-slate-900 shadow-xs dark:bg-slate-800 dark:text-white'
              : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white'
          }`}
          aria-current={locale === 'ru' ? 'page' : undefined}
          aria-label="Переключить на русский язык"
        >
          RU
        </a>
        <span class="text-slate-300 dark:text-slate-700 px-0.5" aria-hidden="true">/</span>
        <a
          href={`${base}/en`}
          data-lang="en"
          class={`lang-link px-2.5 py-1 rounded transition-colors ${
            locale === 'en'
              ? 'bg-white font-bold text-slate-900 shadow-xs dark:bg-slate-800 dark:text-white'
              : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white'
          }`}
          aria-current={locale === 'en' ? 'page' : undefined}
          aria-label="Switch to English"
        >
          EN
        </a>
      </div>

      <!-- Theme Toggle -->
      <button
        type="button"
        id="theme-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label={t.header.themeToggleAria}
        title={t.header.themeToggleAria}
      >
        <!-- Sun icon (for dark mode) -->
        <svg
          class="hidden h-4 w-4 dark:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg
          class="block h-4 w-4 dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-button"
        class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 text-slate-600 transition-colors hover:bg-slate-50 md:hidden dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-900"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
      >
        <svg
          id="menu-open-icon"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-close-icon"
          class="hidden h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav"
    class="hidden border-b border-slate-200 bg-white px-4 py-4 md:hidden dark:border-slate-800 dark:bg-slate-950"
    role="region"
    aria-label="Mobile Navigation"
  >
    <ul class="flex flex-col space-y-1 text-sm font-medium text-slate-700 dark:text-slate-200">
      {
        t.header.nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="mobile-nav-link block rounded-md px-3 py-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-900"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Quick Contact in Mobile Nav -->
    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap gap-2 text-xs font-medium">
      <a
        href={siteConfig.telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1.5 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
      >
        <span>Telegram</span>
      </a>
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1.5 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
      >
        <span>Email</span>
      </a>
      {
        currentCv.available && (
          <a
            href={`${base}${currentCv.path}`}
            download
            class="inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-white dark:bg-brand-500 dark:text-slate-950 font-semibold"
          >
            <span>CV (PDF)</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<script is:inline>
  // Setup theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  // Setup mobile menu
  const menuBtn = document.getElementById('mobile-menu-button');
  const mobileNav = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (menuBtn && mobileNav && openIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    const mobileLinks = mobileNav.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileNav.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  // Language switcher: navigate cleanly to target language at the very top of the page
  const langLinks = document.querySelectorAll('.lang-link');
  langLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = link.getAttribute('href');
      if (target) {
        window.location.href = target;
      }
    });
  });
</script>
